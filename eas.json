{
    "cli": {
      "version": ">= 16.31.0",
      "appVersionSource": "remote"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "ios": {
          "simulator": false
        },
        "channel": "development"
      },
      "preview": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "ios": {
          "simulator": false
        },
        "channel": "preview"
      },
      "production": {
        "autoIncrement": true,
        "channel": "production"
      }
    },
    "submit": {
      "production": {}
    }
  }
  